# Dev/interview defaults. Hostnames "db" and "redis" resolve inside the devcontainer.
# (For a bare local run without the devcontainer, change them to localhost.)
DATABASE_URL=postgres://postgres:postgres@db:5432/bookmarks
REDIS_URL=redis://redis:6379

# NextAuth. NEXTAUTH_URL is generated per-environment into .env.local by scripts/setup-env.mjs.
NEXTAUTH_SECRET=dev-interview-secret-change-me

# App config
PAGE_SIZE=5
